<Window x:Class="UsbWebLauncher.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新" Width="660" Height="590" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="应用更新" FontSize="22" FontWeight="SemiBold" Foreground="#14213D" />
            <TextBlock Margin="0,10,0,0">
                <Run Text="当前版本：" /><Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                <Run Text="    可用版本：" /><Run Text="{Binding AvailableVersion, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding StatusText}" Margin="0,10,0,12" TextWrapping="Wrap" />
        </StackPanel>
        <TextBox Grid.Row="1" Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12"
                 AutomationProperties.Name="更新说明（纯文本）" />
        <StackPanel Grid.Row="2">
            <ProgressBar Margin="0,12,0,0" Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
            <TextBlock Text="{Binding InstallationTargetNotice}" FontSize="12" Foreground="#637083"
                       Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SignatureNotice}" FontSize="12" Foreground="#637083"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding InstallationGuidance}" FontSize="12" Foreground="#637083"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="重新检查" Click="OnCheckClicked" IsEnabled="{Binding CanCheck}" Padding="14,8" Margin="0,0,8,0" />
                <Button Content="下载更新" Click="OnDownloadClicked" IsEnabled="{Binding CanDownload}" Padding="14,8" Margin="0,0,8,0" />
                <Button Content="取消操作" Click="OnCancelClicked" IsEnabled="{Binding IsBusy}" Padding="14,8" Margin="0,0,8,0" />
                <Button Content="安装并退出" Click="OnInstallClicked" IsEnabled="{Binding CanInstall}" Padding="14,8"
                        Background="#2F80ED" Foreground="White" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
