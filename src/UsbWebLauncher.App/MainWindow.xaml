<Window x:Class="UsbWebLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="USB Web Launcher"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14213D" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="17" Background="#2F80ED">
                    <TextBlock Text="W"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="USB Web Launcher"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="16" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#C7D2E5"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="#253554"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeviceStatusText}" Foreground="#F3F6FA" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="BrowserContainer" Grid.Row="1"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBrowserVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <Border Grid.Row="0"
                    Padding="18,14"
                    Margin="18,10"
                    Background="White"
                    BorderBrush="#DCE4EF"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Button Content="安装环境" Padding="20,9" MinWidth="120"
                                    Command="{Binding InstallNativePromptBrokerCommand}" />
                            <Button Content="▾" Padding="9,9" Click="OnMaintenanceMenuClicked"
                                    IsEnabled="{Binding CanInstallNativePromptBroker}"
                                    AutomationProperties.Name="环境维护菜单" ToolTip="环境维护">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="检查完整环境 / 官方安装入口" Click="OnDependencyPreparationClicked" />
                                        <MenuItem Header="安装 / 更新认证组件" Command="{Binding InstallNativePromptBrokerCommand}" />
                                        <MenuItem Header="卸载环境" Command="{Binding UninstallNativePromptBrokerCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Button Content="设置 PIN" Padding="20,9" MinWidth="120"
                                    Command="{Binding ValidateAndSavePinCommand}" />
                            <Button Content="▾" Padding="9,9" Click="OnMaintenanceMenuClicked"
                                    IsEnabled="{Binding CanDeletePin}"
                                    AutomationProperties.Name="PIN 维护菜单" ToolTip="PIN 维护">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="更换 PIN" Command="{Binding ResetPinCommand}" />
                                        <MenuItem Header="删除本机 PIN" Command="{Binding DeletePinCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <Button Content="{Binding BusinessButtonText}" Padding="24,9" MinWidth="144"
                                Background="#2F80ED" Foreground="White" BorderBrush="#2F80ED"
                                Command="{Binding BusinessButtonCommand}" />
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                            <ComboBox Width="72" Margin="0,0,8,0" Padding="10,7"
                                      VerticalContentAlignment="Center" IsEditable="False"
                                      ItemsSource="{Binding ExportNumbers}"
                                      SelectedItem="{Binding SelectedExportNumber, Mode=TwoWay}"
                                      AutomationProperties.Name="导出月份"
                                      ToolTip="当年月份">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                            <Button Content="导出流水和回单" Padding="20,9" MinWidth="180"
                                    Command="{Binding ExportDocumentsCommand}"
                                    ToolTip="依次保存所选月份流水和第一页电子回单；流水失败或为空时停止，文件保存到下载目录" />
                        </StackPanel>
                        <Button Content="下载目录" Padding="16,9" Margin="14,0,0,0"
                                Click="OnConfigureDownloadDirectoryClicked"
                                ToolTip="设置流水、电子回单 PDF 和其他网页下载文件的保存文件夹">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock x:Name="DownloadDirectoryText" Margin="0,10,0,0"
                                       TextTrimming="CharacterEllipsis" Foreground="#637083" FontSize="12"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding CurrentPinText}"
                                       TextWrapping="Wrap" Foreground="#637083" FontSize="12" />
                            <TextBlock Margin="0,12,0,0" Text="{Binding NativePromptBrokerStatusText}"
                                       TextWrapping="Wrap" Foreground="#637083" FontSize="12" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding AuthenticationStatusText}"
                                       TextWrapping="Wrap" Foreground="#637083" FontSize="12" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding StatusText}"
                                       TextWrapping="Wrap" Foreground="#263548" FontSize="12" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding ExportStatusText}"
                                       TextWrapping="Wrap" Foreground="#263548" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExportStatusText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" Margin="0,12,0,0" Padding="16,12"
                                Background="#F3F7FD" BorderBrush="#DCE4EF" BorderThickness="1"
                                CornerRadius="6" VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CompanyCardTitle}" Foreground="#637083" FontSize="12" />
                                <TextBlock Text="{Binding CurrentCompanyText}" Margin="0,6,0,0"
                                           Foreground="#14213D" FontSize="17" FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding CurrentCompanyText}"
                                           AutomationProperties.Name="当前公司名称" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ProgressBar Margin="0,10,0,0" Height="4" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>
            <Border Grid.Row="1"
                    Margin="32"
                    Padding="36"
                    CornerRadius="18"
                    Background="White"
                    BorderBrush="#DCE4EF"
                    BorderThickness="1"
                    MaxWidth="660"
                    MaxHeight="330"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBrowserVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding IdleTitle}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#14213D"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding IdleDescription}"
                               Margin="0,12,0,0"
                               FontSize="14"
                               Foreground="#637083"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="USB 匹配仅用于启动流程，不代表身份验证。"
                               Margin="0,10,0,0"
                               FontSize="13"
                               Foreground="#8A5A00"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorDetail}"
                               Margin="0,22,0,0"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Button x:Name="RetryButton"
                            Click="OnRetryClicked"
                            Margin="0,22,0,0"
                            Padding="24,9"
                            Content="重试"
                            Background="#2F80ED"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

