<Window x:Class="UsbWebLauncher.App.PinSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本机认证设置"
        Width="420"
        Height="230"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置固定本机 PIN"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,12"
                   Text="PIN 将保存到当前 Windows 用户的凭据管理器；USB Key 出现后程序会自动读取并验证。"
                   TextWrapping="Wrap"
                   Foreground="#526173" />
        <TextBox x:Name="PinTextBox"
                 Grid.Row="2"
                 MinHeight="34"
                 MaxLength="256" />
        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   Text="PIN 将以明文显示；保存后输入框会立即清空。"
                   Foreground="#6B7280" />
        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="取消"
                    MinWidth="82"
                    Margin="0,0,10,0"
                    IsCancel="True" />
            <Button Content="保存固定 PIN"
                    MinWidth="108"
                    IsDefault="True"
                    Click="OnConfirmClicked" />
        </StackPanel>
    </Grid>
</Window>
